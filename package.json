{
  "name": "dsh-commandcode-subscription",
  "version": "0.1.12",
  "description": "Command Code Go models for DeepSeek Harness",
  "keywords": ["deepseek-harness", "dsh-plugin", "commandcode", "command-code", "commandcode-go", "llm", "multi-account", "usage-tracking", "vision-models"],
  "type": "module",
  "main": "./lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-model-selection", "@deepseek-ai/dsh-client-ui-slots"] } },
  "files": ["lib/*.js", "cordis.patch.yml", "locale/*.json", "docs/plugin/*.md", "README.md", "README.en.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build"
  },
  "engines": { "node": ">=22.19.0", "dsh": "0.2.1-rc.5 || 0.2.2-rc.1" },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@earendil-works/pi-ai": "^1.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.5",
    "@earendil-works/pi-ai": "1.1.0"
  },
  "repository": { "type": "git", "url": "git+https://github.com/LingBrian/dsh-commandcode-subscription.git" },
  "bugs": { "url": "https://github.com/LingBrian/dsh-commandcode-subscription/issues" },
  "homepage": "https://github.com/LingBrian/dsh-commandcode-subscription",
  "license": "MIT"
}
